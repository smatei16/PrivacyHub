{
  "manifest_version": 3,
  "name": "PrivacyHub",
  "version": "5.0",
  "description": "Analyzes website privacy policies using Claude AI and rates them with a privacy score.",
  "permissions": ["scripting", "activeTab", "storage", "notifications"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["consent-keywords.js", "policy-detection.js", "cookie-consent.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_page": "options.html"
}